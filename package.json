{
  "name": "egen-theme-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "preinstall": "node scripts/require-pnpm.mjs",
    "prepare": "husky || true",
    "generate-theme-registry": "tsx scripts/generate-registry.ts",
    "db:seed": "tsx scripts/migrate.ts",
    "minify-live-preview": "terser public/live-preview.js -o public/live-preview.min.js -c -m",
    "prebuild": "pnpm run generate-theme-registry",
    "postbuild": "pnpm minify-live-preview",
    "db:migrate": "tsx scripts/migrate.ts",
    "build:tools": "esbuild scripts/migrate.ts scripts/create-oauth-app.ts --bundle --platform=node --format=cjs --target=node20 --external:pg-native --out-extension:.js=.cjs --outdir=dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:skeleton": "tsx scripts/generate-token-skeleton.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-beta.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@egen-civitas/esm-embed-client": "^0.3.1",
    "@egen-civitas/esm-embed-protocol": "^0.5.0",
    "@hookform/resolvers": "^5.2.1",
    "@lexical/react": "^0.31.0",
    "@tanstack/react-query": "^5.81.2",
    "@tanstack/react-query-devtools": "^5.81.2",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cuid": "^3.0.0",
    "culori": "^4.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.42.0",
    "embla-carousel-react": "^8.6.0",
    "idb-keyval": "^6.2.2",
    "input-otp": "^1.4.2",
    "isbot": "^5.1.26",
    "lexical": "^0.31.0",
    "lucide-react": "^0.488.0",
    "motion": "^12.7.3",
    "next": "15.4.10",
    "next-themes": "^0.4.6",
    "nuqs": "^2.4.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^4.7.1",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^2.15.4",
    "screenfull": "^6.0.2",
    "server-only": "^0.0.1",
    "shadcn": "^3.8.5",
    "sonner": "^2.0.3",
    "streamdown": "^2.4.0",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.2.0",
    "tippy.js": "^6.3.7",
    "use-scramble": "^2.2.15",
    "use-stick-to-bottom": "^1.1.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "15.4.10",
    "@ngard/tiny-isequal": "^1.1.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/culori": "^2.1.1",
    "@types/next": "^9.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.4.10",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^4",
    "terser": "^5.51.2",
    "tsx": "^4.19.3",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5",
    "typescript-eslint": "^8.54.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "msw"
    ]
  }
}
