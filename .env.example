# EGEN Theme Studio — configuration.
#   Docker :  cp .env.example .env  puis  docker compose up -d --build
#   Dev    :  cp .env.example .env  puis  pnpm dev   (Next.js lit aussi .env)

###### URL PUBLIQUE ######
# URL à laquelle les utilisateurs accèdent au service (sans "/" final).
BASE_URL="http://localhost:3000"
# Même valeur, inlinée au build : liens de partage, registre shadcn, MCP, script d'aperçu.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

###### BASE DE DONNÉES (PostgreSQL) ######
# Docker : seuls ces 3 champs comptent (DATABASE_URL est construite par docker-compose).
# Utiliser un mot de passe sans caractères spéciaux (ex. : openssl rand -hex 16).
POSTGRES_USER="studio"
POSTGRES_PASSWORD="CHANGER_MOI"
POSTGRES_DB="egen_theme_studio"
# Dev hors Docker : pointer vers votre PostgreSQL local. Ajouter ?sslmode=require pour une base distante.
DATABASE_URL="postgresql://studio:CHANGER_MOI@localhost:5432/egen_theme_studio"

###### AUTHENTIFICATION ######
# Secret de chiffrement des sessions (ex. : openssl rand -base64 32).
BETTER_AUTH_SECRET="CHANGER_MOI"

# Connexion via GitHub / Google. Callback à déclarer : <BASE_URL>/api/auth/callback/github (ou /google).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

###### POLICES ######
# Clé Google Fonts API (liste des polices dans l'éditeur) : https://developers.google.com/fonts/docs/developer_api
GOOGLE_FONTS_API_KEY=""

###### OPTIONS ######
# Docker : mettre à 1 pour ne pas appliquer les migrations au démarrage.
# SKIP_MIGRATIONS=1
# Port publié par docker compose.
# APP_PORT=3000

###### INTÉGRATION DANS LE CORE EGEN (iframe) ######
# Origine(s) du Core autorisée(s) à afficher le studio (https, ou http://localhost), séparées par des espaces.
# Ex. : EGEN_FRAME_ANCESTORS="https://egen.exemple.org". Vide = embarquement non autorisé (comportement amont).
# Lue à l'exécution. Connexion : préférer un sous-domaine du même site que le Core (cookies tiers bloqués sinon).
EGEN_FRAME_ANCESTORS=""
# URL publique de l'instance (https ; http://localhost toléré en développement) : publiée dans /egen-config.json.
EGEN_PUBLIC_URL=""
